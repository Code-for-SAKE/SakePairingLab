{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 50 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "title": { "type": "string", "maxLength": 50 },
        "contributionScore": { "type": "number" },
        "tastePreferences": { "type": "object" },
        "role": { "type": "string", "enum": ["user", "admin"] }
      },
      "required": ["id", "displayName", "title", "contributionScore"]
    },
    "Sake": {
      "title": "Sake",
      "description": "Sake bottle information",
      "type": "object",
      "properties": {
        "brewery": { "type": "string", "maxLength": 100 },
        "brand": { "type": "string", "maxLength": 100 },
        "bottle": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "number" },
        "createdBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["brewery", "brand", "bottle", "createdAt", "createdBy"]
    },
    "TasteProfile": {
      "title": "TasteProfile",
      "type": "object",
      "properties": {
        "broads": {
          "type": "array",
          "items": { "type": "string", "maxLength": 50 },
          "maxLength": 10
        },
        "specific": {
          "type": "array",
          "items": { "type": "string", "maxLength": 50 },
          "maxLength": 20
        },
        "custom": { "type": "string", "maxLength": 200 }
      },
      "required": ["broads", "specific"]
    },
    "Review": {
      "title": "Review",
      "description": "A user's tasting review of a Sake",
      "type": "object",
      "properties": {
        "sakeId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "rating": { "type": "number" },
        "aroma": { "$ref": "#/entities/TasteProfile" },
        "taste": { "$ref": "#/entities/TasteProfile" },
        "temperature": { "type": "string", "maxLength": 50 },
        "vessel": { "type": "string", "maxLength": 100 },
        "pairing": { "type": "string", "maxLength": 200 },
        "comment": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "number" },
        "likesCount": { "type": "number" },
        "questId": { "type": "string", "maxLength": 128 }
      },
      "required": [
        "sakeId",
        "userId",
        "aroma",
        "taste",
        "temperature",
        "vessel",
        "pairing",
        "createdAt",
        "likesCount"
      ]
    },
    "Quest": {
      "title": "Quest",
      "description": "Pairing challenge quest definition",
      "type": "object",
      "properties": {
        "sakeId": { "type": "string", "maxLength": 128 },
        "sakeBrand": { "type": "string", "maxLength": 100 },
        "sakeBottle": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "targetTemperature": { "type": "string", "maxLength": 50 },
        "targetVessel": { "type": "string", "maxLength": 100 },
        "targetPairing": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["open", "completed"] },
        "rewardPoints": { "type": "number" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "status", "rewardPoints", "createdBy", "createdAt"]
    },
    "ClusterDoc": {
      "title": "ClusterDoc",
      "description": "Stores the cluster information for sake embeddings",
      "type": "object",
      "properties": {
        "count": { "type": "number" },
        "centroid": {
          "type": "array",
          "items": { "type": "number" }
        },
        "createdAt": { "type": "number" }
      },
      "required": ["count", "centroid", "createdAt"]
    },
    "NetworkNode": {
      "title": "NetworkNode",
      "description": "A node in the sake similarity network graph",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "label": { "type": "string", "maxLength": 300 },
        "cluster": { "type": "number" },
        "info": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "label", "cluster", "info"]
    },
    "NetworkLink": {
      "title": "NetworkLink",
      "description": "A weighted edge between two nodes in the sake similarity network",
      "type": "object",
      "properties": {
        "source": { "type": "string", "maxLength": 128 },
        "target": { "type": "string", "maxLength": 128 },
        "weight": { "type": "number" }
      },
      "required": ["source", "target", "weight"]
    },
    "SakeNetwork": {
      "title": "SakeNetwork",
      "description": "Cached sake similarity network data (nodes + links) generated by rebuildSakeNetworkData",
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/entities/NetworkNode" }
        },
        "links": {
          "type": "array",
          "items": { "$ref": "#/entities/NetworkLink" }
        },
        "nodeCount": { "type": "number" },
        "linkCount": { "type": "number" },
        "clusterCount": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["nodes", "links", "nodeCount", "linkCount", "clusterCount"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles"
    },
    "/sakes/{sakeId}": {
      "schema": { "$ref": "#/entities/Sake" },
      "description": "Stores sake database entries"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Stores user reviews of sakes"
    },
    "/quests/{questId}": {
      "schema": { "$ref": "#/entities/Quest" },
      "description": "Stores pairing challenge quests"
    },
    "/clusterSakes/{clusterId}": {
      "schema": { "$ref": "#/entities/ClusterDoc" },
      "description": "Stores cluster information for sake embeddings"
    },
    "/sakeNetwork/{networkId}": {
      "schema": { "$ref": "#/entities/SakeNetwork" },
      "description": "Stores cached sake similarity network data for visualization"
    }
  }
}
